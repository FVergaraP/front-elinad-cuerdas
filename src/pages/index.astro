---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CoursesSection from '@/components/sections/CoursesSection.astro';
import ScheduleSection from '@/components/sections/ScheduleSection.astro';
import WhatsappButton from '@/components/ui/WhatsappButton.astro';
import { contenido } from '@/data/content';
import { withBase } from '@/lib/url';

const { portada, sobreMi, testimonios, formaDeEnsenar, contactoFinal, redes } = contenido;
const kofi = redes.find((r) => r.icono === 'kofi');
---

<BaseLayout>
  <!-- ====================================================
       HERO
       ==================================================== -->
  <section
    id="inicio"
    aria-label="Presentación"
    class="relative overflow-hidden py-24 md:py-36 px-4 sm:px-6 lg:px-8"
  >
    <!-- Foto de fondo -->
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img
        src={withBase(portada.imagenFondo)}
        alt=""
        class="w-full h-full object-cover object-center"
        fetchpriority="high"
        decoding="async"
        data-key="portada.imagen_fondo"
      />
      <!-- Overlay degradado para legibilidad del texto -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/60 to-black/80"></div>
    </div>

    <div class="max-w-4xl mx-auto text-center">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-[0.2em]
               text-theme-accent border border-theme-accent/60 rounded-full
               px-4 py-1.5 mb-6 backdrop-blur-sm"
        data-key="portada.pre_titulo"
      >
        {portada.preTitulo}
      </span>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-display font-bold text-white leading-tight drop-shadow-lg"
        data-key="portada.titulo"
      >
        {portada.titulo}
      </h1>

      <p
        class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed drop-shadow"
        data-key="portada.descripcion"
      >
        {portada.descripcion}
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#cursos" class="btn-primary text-base px-7 py-4" data-key="portada.boton_ver_cursos">
          {portada.botonVerCursos}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>
        <WhatsappButton
          message={portada.mensajeWhatsapp}
          label={portada.botonWhatsapp}
          variant="secondary"
          size="lg"
        />
      </div>

      <!-- Estadísticas rápidas -->
      <div class="mt-16 grid grid-cols-3 gap-6 max-w-lg mx-auto" data-key="portada.estadisticas">
        {portada.estadisticas.map(({ numero, etiqueta }) => (
          <div class="text-center backdrop-blur-sm bg-white/5 rounded-2xl py-3 px-2">
            <div class="text-2xl font-display font-bold text-theme-accent">{numero}</div>
            <div class="text-xs text-white/70 mt-0.5">{etiqueta}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================
       CURSOS Y TALLERES
       ==================================================== -->
  <CoursesSection />

  <!-- ====================================================
       HORARIOS
       ==================================================== -->
  <ScheduleSection />

  <!-- ====================================================
       SOBRE MÍ
       ==================================================== -->
  <section
    id="sobre-mi"
    aria-labelledby="about-heading"
    class="py-20 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Foto de perfil -->
        <div class="relative">
          <div class="aspect-[3/4] rounded-3xl overflow-hidden shadow-2xl ring-4 ring-theme-accent/20">
            <img
              src={withBase(sobreMi.imagen)}
              alt={sobreMi.imagenDescripcion}
              class="w-full h-full object-cover object-top"
              loading="lazy"
              decoding="async"
              data-key="sobre_mi.imagen"
            />
          </div>
          <!-- Detalle decorativo -->
          <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-theme-accent/20 rounded-full blur-2xl -z-10"></div>
          <div class="absolute -top-4 -left-4 w-16 h-16 bg-theme-accent/10 rounded-full blur-xl -z-10"></div>
        </div>

        <!-- Texto -->
        <div>
          <span class="text-theme-accent font-semibold text-sm uppercase tracking-widest" data-key="sobre_mi.pre_titulo">
            {sobreMi.preTitulo}
          </span>
          <h2 id="about-heading" class="section-title mt-2" data-key="sobre_mi.titulo">
            {sobreMi.titulo}
          </h2>
          <div class="space-y-4 mt-5 text-theme-muted leading-relaxed" data-key="sobre_mi.parrafos">
            {sobreMi.parrafos.map((parrafo) => <p>{parrafo}</p>)}
          </div>
          <WhatsappButton
            message={sobreMi.mensajeWhatsapp}
            label={sobreMi.boton}
            class="mt-8"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       TESTIMONIOS
       ==================================================== -->
  <section
    id="testimonios"
    aria-labelledby="testimonials-heading"
    class="py-20 px-4 sm:px-6 lg:px-8 bg-theme-surface/40"
  >
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="text-theme-accent font-semibold text-sm uppercase tracking-widest" data-key="testimonios.pre_titulo">
          {testimonios.preTitulo}
        </span>
        <h2 id="testimonials-heading" class="section-title mt-2" data-key="testimonios.titulo">
          {testimonios.titulo}
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6" data-key="testimonios.listado">
        {testimonios.listado.map(({ nombre, rol, comentario }) => (
          <blockquote class="card p-6 flex flex-col gap-4">
            <p class="text-theme-muted text-sm leading-relaxed flex-1">
              "{comentario}"
            </p>
            <footer>
              <cite class="not-italic">
                <span class="block font-semibold text-theme-text text-sm">{nombre}</span>
                <span class="block text-xs text-theme-accent">{rol}</span>
              </cite>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================
       EN VIVO / MI FORMA DE ENSEÑAR
       ==================================================== -->
  <section
    aria-label="Elinad en vivo"
    class="relative overflow-hidden py-0"
  >
    <div class="relative h-[420px] md:h-[540px]">
      <img
        src={withBase(formaDeEnsenar.imagen)}
        alt={formaDeEnsenar.imagenDescripcion}
        class="w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
        data-key="forma_de_ensenar.imagen"
      />
      <!-- Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>

      <!-- Contenido sobre la imagen -->
      <div class="absolute inset-0 flex items-center px-8 sm:px-16 lg:px-24">
        <div class="max-w-lg">
          <span class="text-theme-accent font-semibold text-sm uppercase tracking-widest" data-key="forma_de_ensenar.pre_titulo">
            {formaDeEnsenar.preTitulo}
          </span>
          <h2
            class="text-3xl sm:text-4xl font-display font-bold text-white mt-2 leading-tight drop-shadow-lg"
            data-key="forma_de_ensenar.titulo"
          >
            {formaDeEnsenar.titulo}
          </h2>
          <div class="mt-4 text-white/80 leading-relaxed text-base space-y-3" data-key="forma_de_ensenar.parrafos">
            {formaDeEnsenar.parrafos.map((parrafo) => <p>{parrafo}</p>)}
          </div>
          <a
            href="#cursos"
            class="mt-7 inline-flex items-center gap-2 btn-primary"
            data-key="forma_de_ensenar.boton"
          >
            {formaDeEnsenar.boton}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       CONTACTO / CTA FINAL
       ==================================================== -->
  <section
    id="contacto"
    aria-labelledby="contact-heading"
    class="py-20 px-4 sm:px-6 lg:px-8 bg-theme-surface/40"
  >
    <div class="max-w-2xl mx-auto text-center">
      <span class="text-theme-accent font-semibold text-sm uppercase tracking-widest" data-key="contacto_final.pre_titulo">
        {contactoFinal.preTitulo}
      </span>
      <h2 id="contact-heading" class="section-title mt-2" data-key="contacto_final.titulo">
        {contactoFinal.titulo}
      </h2>
      <p class="section-subtitle mx-auto mt-4" data-key="contacto_final.descripcion">
        {contactoFinal.descripcion}
      </p>
      <WhatsappButton
        message={contactoFinal.mensajeWhatsapp}
        label={contactoFinal.botonWhatsapp}
        size="lg"
        class="mt-10"
      />
      <p class="text-xs text-theme-muted mt-4" data-key="contacto_final.nota">{contactoFinal.nota}</p>

      <!-- Ko-fi — apoyo voluntario discreto -->
      <div class="mt-8 mx-auto max-w-xs rounded-2xl bg-theme-surface/60 border border-theme-border/40 px-5 py-4 text-center">
        <p class="text-xs text-theme-muted leading-relaxed mb-3 whitespace-pre-line" data-key="contacto_final.caja_kofi.texto">
          {contactoFinal.cajaKofi.texto}
        </p>
        <a
          href={kofi?.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-medium text-xs
                 bg-theme-border/50 hover:bg-theme-border text-theme-muted hover:text-theme-text
                 transition-all duration-200"
          aria-label="Apoyar a Elinad en Ko-fi"
          data-key="contacto_final.caja_kofi.boton"
        >
          {contactoFinal.cajaKofi.boton}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
