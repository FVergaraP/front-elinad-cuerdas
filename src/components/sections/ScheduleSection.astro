---
import WhatsappButton from '@/components/ui/WhatsappButton.astro';
import { contenido } from '@/data/content';

const s = contenido.horarios;
---

<section
  id="horarios"
  aria-labelledby="schedule-heading"
  class="py-20 px-4 sm:px-6 lg:px-8 bg-theme-surface/40"
>
  <div class="max-w-2xl mx-auto text-center">
    <span class="text-theme-accent font-semibold text-sm uppercase tracking-widest" data-key="horarios.pre_titulo">
      {s.preTitulo}
    </span>
    <h2 id="schedule-heading" class="section-title mt-2" data-key="horarios.titulo">
      {s.titulo}
    </h2>
    <p class="section-subtitle mx-auto mt-4" data-key="horarios.bajada">
      {s.bajada}
    </p>
  </div>

  <div class="max-w-xl mx-auto mt-12 card" data-key="horarios.dias">
    <dl>
      {s.dias.map(({ dia, horas, disponible }, i) => (
        <div
          class:list={[
            'flex items-center justify-between gap-6 px-6 py-4',
            i !== s.dias.length - 1 && 'border-b border-theme-border',
          ]}
        >
          <dt class="font-semibold text-theme-text">{dia}</dt>
          <dd class="text-right">
            {horas.map((h) => (
              <span
                class:list={[
                  'block text-sm text-theme-muted',
                  !disponible && 'italic opacity-60',
                ]}
              >
                {h}
              </span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="mt-10 text-center">
    <WhatsappButton
      message={s.mensajeWhatsapp}
      label={s.botonWhatsapp}
      size="lg"
    />
  </div>
</section>
